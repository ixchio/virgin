FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        clang-format \
        clang-tidy \
        cmake \
        g++ \
        libsqlite3-dev \
        libxkbcommon-dev \
        ninja-build \
        pkg-config \
        qt6-base-dev \
        libqt6sql6-sqlite \
        qt6-webengine-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

CMD ["bash"]
